// 野外整图重绘的地面图块(2026-11-21 用户「优化还不够好的地方」:瀑布 / 河水是静止画):
// 图块本身是一张静态画,水面靠「水流遮罩」(整张地图一张小图,field_repaint.py flow 生成)让局部像素动起来:
//   R = 水面:两组交错的正弦把采样坐标轻轻错开(水波晃动)+ 斜向细高光扫过;
//   G = 白水(瀑布 / 急流的白沫):采样坐标沿竖直方向往下滚 + 亮度条纹往下走,读得出「在往下流」。
// flowRect = 本图块在遮罩里的区域(xy 起点,zw 尺寸);flowParams = (水波幅度,白水幅度,速度,0)——幅度是图块 uv 单位。
// 图块边上几个像素不错位(相邻图块各自采样,错位会露缝)。
CCEffect %{
  techniques:
  - passes:
    - vert: paint-ground-vs:vert
      frag: paint-ground-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        flowTex: { value: black }
        flowRect: { value: [0.0, 0.0, 1.0, 1.0] }
        flowParams: { value: [0.0012, 0.0022, 1.0, 0.0] }
        tileSize: { value: [2048.0, 1024.0, 0.0, 0.0] }
}%

CCProgram paint-ground-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = cc_matViewProj * vec4(a_position, 1);
    uv0 = a_texCoord;
    color = a_color;
    return pos;
  }
}%

CCProgram paint-ground-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec4 color;
  in vec2 uv0;

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform sampler2D flowTex;

  uniform PaintGround {
    vec4 flowRect;
    vec4 flowParams;
    vec4 tileSize;
  };

  vec4 frag () {
    vec2 m = texture(flowTex, flowRect.xy + uv0 * flowRect.zw).rg;
    if (m.r + m.g < 0.01) {
      return texture(cc_spriteTexture, uv0) * color;
    }
    float t = cc_time.x * flowParams.z;
    // 图块像素坐标(做波纹的空间频率,和图块大小无关)
    vec2 p = uv0 * tileSize.xy;
    vec2 edge = min(p, tileSize.xy - p);
    float keep = clamp(min(edge.x, edge.y) / 6.0 - 0.5, 0.0, 1.0);
    vec2 off = vec2(
      sin(p.y * 0.045 + t * 1.9 + sin(p.x * 0.021 + t * 0.7) * 1.6),
      cos(p.x * 0.038 - t * 1.6 + sin(p.y * 0.027 - t * 0.5) * 1.4)
    ) * flowParams.x * m.r;
    // 白水:往下滚(uv.y 增大 = 画面往下)
    float fall = sin(p.y * 0.11 - t * 9.0 + sin(p.x * 0.07) * 2.5);
    off.y += fall * flowParams.y * m.g;
    off.x += sin(p.y * 0.05 - t * 4.0 + p.x * 0.09) * flowParams.y * 0.35 * m.g;
    vec4 o = texture(cc_spriteTexture, uv0 + off * keep);
    // 水面斜向细高光 / 白水亮条往下走
    float glint = pow(max(0.0, sin(p.x * 0.031 + p.y * 0.052 + t * 1.3) * sin(p.y * 0.043 - p.x * 0.017 - t * 1.05)), 10.0);
    float streak = pow(max(0.0, sin(p.y * 0.075 - t * 11.0 + sin(p.x * 0.13) * 3.0)), 6.0);
    o.rgb += glint * 0.10 * m.r + streak * 0.07 * m.g;
    return o * color;
  }
}%
