// 野外整图重绘的地面图块(2026-11-21 用户「优化还不够好的地方」:瀑布 / 河水是静止画):
// 图块本身是一张静态画,水面靠「水流遮罩」(整张地图一张小图,field_repaint.py flow 生成)让局部像素动起来:
//   R = 水面:两组交错的正弦把采样坐标轻轻错开(水波晃动)+ 斜向细高光扫过;
//   G = 白水(瀑布 / 急流的白沫):采样坐标沿竖直方向往下滚 + 亮度条纹往下走,读得出「在往下流」。
// flowRect = 本图块在遮罩里的区域(xy 起点,zw 尺寸);flowParams = (水波幅度,白水幅度,速度,0)——幅度是图块 uv 单位。
// 图块边上几个像素不错位(相邻图块各自采样,错位会露缝)。
// 11-22 用户看守卫战参考图:「地面有光感」「看起来很精细,极致的画质,不是模糊的」→ 所有重绘图的图块都走这里,
// lookParams = (锐化, 起伏受光, 局部对比, 亮部提亮):
//   锐化 = 原像素减上下左右 1 像素平均(图块在手机上被放大约 1.4 倍,补回边缘);
//   起伏受光 = 把亮度当高度,左上方来的光:朝光一侧提亮、背光一侧压暗(石头 / 车辙 / 土坎立起来);
//   局部对比 = 半径约 5 像素的「清晰度」(大块明暗更分明,不加颗粒);
//   亮部提亮 = 亮处再抬一点(受光的地面有光感)。
CCEffect %{
  techniques:
  - passes:
    - vert: paint-ground-vs:vert
      frag: paint-ground-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        flowTex: { value: black }
        flowRect: { value: [0.0, 0.0, 1.0, 1.0] }
        flowParams: { value: [0.0012, 0.0022, 1.0, 0.0] }
        tileSize: { value: [2048.0, 1024.0, 0.0, 0.0] }
        lookParams: { value: [0.0, 0.0, 0.0, 0.0] }
}%

CCProgram paint-ground-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = cc_matViewProj * vec4(a_position, 1);
    uv0 = a_texCoord;
    color = a_color;
    return pos;
  }
}%

CCProgram paint-ground-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec4 color;
  in vec2 uv0;

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform sampler2D flowTex;

  uniform PaintGround {
    vec4 flowRect;
    vec4 flowParams;
    vec4 tileSize;
    vec4 lookParams;
  };

  float lum (vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
  }

  vec3 look (vec3 base) {
    vec2 tx = 1.0 / tileSize.xy;
    // 图块边上几个像素渐弱(相邻图块各自采样,边上算出来的不一样会露缝)
    vec2 p = uv0 * tileSize.xy;
    vec2 edge = min(p, tileSize.xy - p);
    float fade = clamp(min(edge.x, edge.y) / 4.0 - 0.25, 0.0, 1.0);
    if (fade <= 0.0) {
      return base;
    }
    vec3 n = texture(cc_spriteTexture, uv0 + vec2(0.0, -tx.y)).rgb;
    vec3 s = texture(cc_spriteTexture, uv0 + vec2(0.0, tx.y)).rgb;
    vec3 e = texture(cc_spriteTexture, uv0 + vec2(tx.x, 0.0)).rgb;
    vec3 w = texture(cc_spriteTexture, uv0 + vec2(-tx.x, 0.0)).rgb;
    vec3 rgb = base + (base - (n + s + e + w) * 0.25) * lookParams.x;
    // 左上来光:往右下亮度变高 = 朝光坡面(uv.y 向下)
    float shade = (lum(e) - lum(w)) + (lum(s) - lum(n));
    rgb *= 1.0 + clamp(shade * lookParams.y, -0.3, 0.3);
    if (lookParams.z > 0.0) {
      vec2 r = tx * 5.0;
      vec3 far = texture(cc_spriteTexture, uv0 + vec2(r.x, r.y)).rgb + texture(cc_spriteTexture, uv0 + vec2(-r.x, r.y)).rgb
        + texture(cc_spriteTexture, uv0 + vec2(r.x, -r.y)).rgb + texture(cc_spriteTexture, uv0 + vec2(-r.x, -r.y)).rgb;
      rgb += (base - far * 0.25) * lookParams.z;
    }
    rgb += rgb * smoothstep(0.42, 0.85, lum(rgb)) * lookParams.w;
    return mix(base, clamp(rgb, 0.0, 1.0), fade);
  }

  vec4 frag () {
    vec2 m = texture(flowTex, flowRect.xy + uv0 * flowRect.zw).rg;
    if (m.r + m.g < 0.01) {
      vec4 b = texture(cc_spriteTexture, uv0);
      return vec4(look(b.rgb), b.a) * color;
    }
    float t = cc_time.x * flowParams.z;
    // 图块像素坐标(做波纹的空间频率,和图块大小无关)
    vec2 p = uv0 * tileSize.xy;
    vec2 edge = min(p, tileSize.xy - p);
    float keep = clamp(min(edge.x, edge.y) / 6.0 - 0.5, 0.0, 1.0);
    vec2 off = vec2(
      sin(p.y * 0.045 + t * 1.9 + sin(p.x * 0.021 + t * 0.7) * 1.6),
      cos(p.x * 0.038 - t * 1.6 + sin(p.y * 0.027 - t * 0.5) * 1.4)
    ) * flowParams.x * m.r;
    // 白水:往下滚(uv.y 增大 = 画面往下)
    float fall = sin(p.y * 0.11 - t * 9.0 + sin(p.x * 0.07) * 2.5);
    off.y += fall * flowParams.y * m.g;
    off.x += sin(p.y * 0.05 - t * 4.0 + p.x * 0.09) * flowParams.y * 0.35 * m.g;
    vec4 o = texture(cc_spriteTexture, uv0 + off * keep);
    // 水面斜向细高光 / 白水亮条往下走
    float glint = pow(max(0.0, sin(p.x * 0.031 + p.y * 0.052 + t * 1.3) * sin(p.y * 0.043 - p.x * 0.017 - t * 1.05)), 10.0);
    float streak = pow(max(0.0, sin(p.y * 0.075 - t * 11.0 + sin(p.x * 0.13) * 3.0)), 6.0);
    o.rgb += glint * 0.16 * m.r + streak * 0.08 * m.g;
    return o * color;
  }
}%
