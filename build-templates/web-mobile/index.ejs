<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <title>LootChain</title>

  <!--http://www.html5rocks.com/en/mobile/mobifying/-->
  <meta name="viewport"
        content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"/>

  <!--https://developer.apple.com/library/safari/documentation/AppleApplications/Reference/SafariHTMLRef/Articles/MetaTags.html-->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="format-detection" content="telephone=no">

  <!-- force webkit on 360 -->
  <meta name="renderer" content="webkit"/>
  <meta name="force-rendering" content="webkit"/>
  <!-- force edge on IE -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <meta name="msapplication-tap-highlight" content="no">

  <!-- force full screen on some browser -->
  <meta name="full-screen" content="yes"/>
  <meta name="x5-fullscreen" content="true"/>
  <meta name="360-fullscreen" content="true"/>

  <!--fix fireball/issues/3568 -->
  <meta name="browsermode" content="application">
  <meta name="x5-page-mode" content="app">

  <!-- 仅横屏(2026-10-02 用户拍板):UC / QQ(X5) 浏览器按横屏打开;其余浏览器竖握时由引擎旋转画布 -->
  <meta name="screen-orientation" content="landscape">
  <meta name="x5-orientation" content="landscape">

  <!--<link rel="apple-touch-icon" href=".png" />-->
  <!--<link rel="apple-touch-icon-precomposed" href=".png" />-->

  <link rel="stylesheet" type="text/css" href="<%= cssUrl %>"/>
  <!-- 黑底(留边 / 刘海区不再是灰色);禁止页面滚动和回弹,引擎旋转画布时 GameDiv 的布局盒在屏幕右侧,不允许被拖出来;
       不要给 body 设 position:fixed / 改高度——引擎的安卓软键盘补偿依赖 body.scrollHeight -->
  <style>
    html, body { background: #000; overflow: hidden; overscroll-behavior: none; }
    #GameDiv { overflow: hidden; }
  </style>
  <!-- 引擎 DPR 封顶(release-web.mjs 出包补丁读这个值,2026-10-06):必须在引擎初始化前就有,
       否则引擎先按 2 建渲染窗口、后续画面只画在左下角一块(2026-10-07 极致档 DPR 2.6 实测) -->
  <script>window.__lcMaxDevicePixelRatio = 3;</script>

</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="true">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
      </div>
    </div>
  <!-- 2026-11-24 用户线上黑屏:浏览器拿不到 WebGL(引擎报 16405「不支持 WebGL2」+ 16333「不支持 WebGL」,建画布时 getExtension of null)。
       查实:同一台电脑新开的 Chrome 正常(RTX 5070 硬件加速),是开机就后台常驻的那个 Chrome 进程显卡状态坏了;它「关闭后继续在后台运行」,
       只关窗口不会重启显卡进程,刷新多少次都黑。引擎(3.8.8)碰到上下文丢失也只打警告不恢复,玩到一半显卡一重置就永久黑屏。
       这里做三件事:
       1) 引擎启动前用临时画布试 WebGL2 / WebGL1,都拿不到 → 盖提示页(第一步就是 chrome://restart,能真正重启后台常驻的浏览器);
       2) 引擎建画布时才失败(16333 / 16405 / getExtension of null)→ 同一个提示页;
       3) 游戏画布上下文丢失 → 「画面中断,正在恢复」,浏览器还原上下文就自动刷新;8 秒没恢复换成带步骤的提示页。
       提示页出来后每 2 秒检测一次 WebGL,能用了就自动刷新回游戏;5 分钟内最多自动刷新 3 次,防止死循环。 -->
  <style>
    #lcNoGL { position: fixed; inset: 0; z-index: 2147483000; display: flex; align-items: center; justify-content: center;
      background: radial-gradient(ellipse at 50% 35%, #1b2130 0%, #0b0d12 70%); color: #e8e3d6; padding: 16px; box-sizing: border-box;
      font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif; }
    #lcNoGL .card { width: 100%; max-width: 580px; max-height: 100%; overflow-y: auto; box-sizing: border-box; padding: 22px 26px 22px; border-radius: 14px;
      background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.14); box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45); }
    #lcNoGL .mark { text-align: center; letter-spacing: 0.6em; font-size: 22px; color: #fff; margin: 0 0 2px; padding-left: 0.6em; }
    #lcNoGL .sub { text-align: center; letter-spacing: 0.5em; font-size: 11px; color: #d8b26a; margin: 0 0 16px; padding-left: 0.5em; }
    #lcNoGL h2 { font-size: 20px; margin: 0 0 8px; color: #fff; font-weight: 600; }
    #lcNoGL p { font-size: 15px; line-height: 1.6; margin: 0 0 10px; color: #cfc8b8; }
    #lcNoGL ol { font-size: 15px; line-height: 1.65; margin: 0 0 14px; padding-left: 1.3em; color: #e8e3d6; }
    #lcNoGL b { color: #e9c983; font-weight: 600; }
    #lcNoGL code { font-family: Consolas, "Courier New", monospace; color: #fff; background: rgba(255, 255, 255, 0.1); padding: 1px 6px; border-radius: 4px; }
    #lcNoGL .btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    #lcNoGL button { min-width: 160px; padding: 10px 22px; font-size: 16px; border-radius: 999px; cursor: pointer; font-family: inherit;
      color: #1a1408; background: linear-gradient(#ecd29a, #c9a35a); border: 1px solid #f3dca8; }
    #lcNoGL button.ghost { color: #e8e3d6; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.25); }
    #lcNoGL .code { text-align: center; font-size: 12px; color: #8a8576; margin: 10px 0 0; }
    #lcNoGL .spin { width: 28px; height: 28px; margin: 6px auto 14px; border-radius: 50%; border: 3px solid rgba(255, 255, 255, 0.15);
      border-top-color: #e9c983; animation: lcspin 0.9s linear infinite; }
    @keyframes lcspin { to { transform: rotate(360deg); } }
    /* 手机横屏(高 ≤ 420):去副标题、收留白和行距,正文字号不缩,一屏放得下不出滚动条 */
    @media (max-height: 420px) {
      #lcNoGL { padding: 8px; }
      #lcNoGL .card { padding: 12px 20px 12px; }
      #lcNoGL .mark { font-size: 18px; margin-bottom: 8px; }
      #lcNoGL .sub { display: none; }
      #lcNoGL h2 { font-size: 18px; margin-bottom: 4px; }
      #lcNoGL p, #lcNoGL ol { line-height: 1.45; margin-bottom: 8px; }
      #lcNoGL button { padding: 7px 18px; }
      #lcNoGL .code { margin-top: 6px; }
    }
  </style>
  <script>
    (function () {
      var RELOAD_KEY = 'lcGlAutoReload';
      var restartUrl = /Edg\//.test(navigator.userAgent) ? 'edge://restart' : 'chrome://restart';
      var box = null;
      var mode = '';
      var poll = null;
      var lostTimer = null;

      function canGL() {
        try {
          var c = document.createElement('canvas');
          var gl = c.getContext('webgl2') || c.getContext('webgl') || c.getContext('experimental-webgl');
          if (!gl) { return false; }
          var lose = gl.getExtension('WEBGL_lose_context');
          if (lose) { lose.loseContext(); }   // 试完立刻释放,不占浏览器的上下文名额
          return true;
        } catch (e) {
          return false;
        }
      }

      // 自动刷新:5 分钟内最多 3 次(防止「检测能用、引擎还是建不起来」时来回刷)
      function autoReload() {
        var now = Date.now();
        var hist = [];
        try { hist = JSON.parse(sessionStorage.getItem(RELOAD_KEY) || '[]'); } catch (e) { hist = []; }
        hist = hist.filter(function (t) { return now - t < 300000; });
        if (hist.length >= 3) { return false; }
        hist.push(now);
        try { sessionStorage.setItem(RELOAD_KEY, JSON.stringify(hist)); } catch (e) { /* 存不了也照样刷新 */ }
        location.reload();
        return true;
      }

      function startPoll() {
        if (poll) { return; }
        poll = setInterval(function () {
          if (canGL()) {
            clearInterval(poll);
            poll = null;
            autoReload();
          }
        }, 2000);
      }

      function render(kind, reason) {
        var body = document.body;
        if (!body) { document.addEventListener('DOMContentLoaded', function () { render(kind, reason); }); return; }
        if (!box) { box = document.createElement('div'); box.id = 'lcNoGL'; body.appendChild(box); }
        var head = '<div class="card"><div class="mark">LOOTCHAIN</div><div class="sub">SILENT GODS</div>';
        if (kind === 'lost') {
          box.innerHTML = head + '<h2>画面中断，正在恢复…</h2><div class="spin"></div>'
            + '<p>显卡暂时中断了（可能是驱动重置或别的程序占满了显卡），恢复后会自动重新进入游戏。</p></div>';
          return;
        }
        box.innerHTML = head + '<h2>游戏画面无法显示</h2>'
          + '<p>浏览器现在无法启用 WebGL（显卡加速）。按下面的顺序试一下，恢复后这个页面会<b>自动重新进入游戏</b>：</p>'
          + '<ol><li>在浏览器地址栏输入 <code>' + restartUrl + '</code> 回车，浏览器会完整重启并恢复标签页。'
          + '（浏览器在后台常驻时，只关窗口不会真正重启。）</li>'
          + '<li>打开浏览器设置，确认开启<b>「使用图形加速功能（如果可用）」</b>。</li>'
          + '<li>还不行的话，更新显卡驱动，或换用最新版 <b>Chrome / Edge</b>。</li></ol>'
          + '<div class="btns"><button type="button" id="lcCopyRestart">复制 ' + restartUrl + '</button>'
          + '<button type="button" class="ghost" onclick="location.reload()">重新加载</button></div>'
          + '<div class="code">WebGL 不可用' + (reason ? '（' + reason + '）' : '') + '</div></div>';
        var btn = document.getElementById('lcCopyRestart');
        if (btn) {
          btn.onclick = function () {
            var done = function () { btn.textContent = '已复制，粘贴到地址栏回车'; };
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(restartUrl).then(done, function () { window.prompt('复制下面这行，粘贴到地址栏回车：', restartUrl); });
              } else {
                window.prompt('复制下面这行，粘贴到地址栏回车：', restartUrl);
              }
            } catch (e) {
              window.prompt('复制下面这行，粘贴到地址栏回车：', restartUrl);
            }
          };
        }
      }

      function show(kind, reason) {
        if (kind === 'lost' && mode === 'nogl') { return; }
        if (mode === kind) { return; }
        mode = kind;
        window.__lcNoWebGL = kind + (reason ? ':' + reason : '');
        render(kind, reason);
        startPoll();
        if (kind === 'lost') {
          clearTimeout(lostTimer);
          lostTimer = setTimeout(function () { if (mode === 'lost') { mode = ''; show('nogl', 'context-lost'); } }, 8000);
        }
      }

      // 1) 引擎启动前预检
      if (!canGL()) { show('nogl', 'precheck'); }

      // 2) 引擎建画布时才失败
      var looksLikeNoGL = function (text) {
        return /Error 16333|Error 16405|reading 'getExtension'|reading "getExtension"/.test(String(text || ''));
      };
      var origError = console.error;
      console.error = function () {
        try {
          for (var i = 0; i < arguments.length; i++) {
            var a = arguments[i];
            if (looksLikeNoGL(a && a.message ? a.message : a)) { show('nogl', 'engine'); break; }
          }
        } catch (e) { /* 只是检测,别影响原来的输出 */ }
        return origError.apply(console, arguments);
      };
      window.addEventListener('error', function (ev) { if (looksLikeNoGL(ev && ev.message)) { show('nogl', 'engine'); } });
      window.addEventListener('unhandledrejection', function (ev) {
        var r = ev && ev.reason;
        if (looksLikeNoGL(r && r.message ? r.message : r)) { show('nogl', 'engine'); }
      });

      // 3) 游戏画布上下文丢失 / 还原(引擎只打警告不恢复)
      var cv = document.getElementById('GameCanvas');
      if (cv) {
        cv.addEventListener('webglcontextlost', function (ev) {
          try { ev.preventDefault(); } catch (e) { /* 有的平台不支持,照样走提示 */ }
          show('lost');
        }, false);
        cv.addEventListener('webglcontextrestored', function () { autoReload(); }, false);
      }
    })();
  </script>
  <%- include(cocosTemplate, {}) %>
</body>
</html>
