# 游戏站点 nginx(Railway 镜像版,对应后端仓 deploy/nginx/lootchain-game.conf;docs/44)。
# HTTPS 由 Railway 边缘终结;本容器只听 $PORT,静态包 + 同域反代 /api、/ws 到游戏服(Railway 内网)。
# 官方 nginx 镜像启动时按已定义的环境变量做 envsubst:PORT、GAME_UPSTREAM、NGINX_LOCAL_RESOLVERS(由 NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 自动从 resolv.conf 取)。

map $http_upgrade $lootchain_connection_upgrade {
    default upgrade;
    ''      close;
}

# 客户端真实 IP:Railway 边缘写在 X-Real-IP;取不到才退回对端地址。
map $http_x_real_ip $lootchain_client_ip {
    default $http_x_real_ip;
    ''      $remote_addr;
}

# 访问日志不记查询串:WebSocket 地址带 ?satoken=<登录令牌>,不能落进日志。
log_format lootchain_noargs '$lootchain_client_ip - [$time_local] "$request_method $uri $server_protocol" '
                            '$status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    access_log /dev/stdout lootchain_noargs;
    error_log  /dev/stderr warn;

    # 内网地址随游戏服重新部署会变:用变量 + resolver 每次按 TTL 重新解析,不在启动时写死
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $lootchain_game http://${GAME_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;

    # 文本类资源必须压缩:怪物骨骼 json 约 42MB,压完约 1/8。.atlas/.bin 无 MIME 映射,按 octet-stream 一并压。
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json application/wasm
               application/octet-stream image/svg+xml;

    # ---------- 游戏 API 与 WebSocket ----------
    location ^~ /api/ {
        # 后台接口不在游戏站点暴露
        location /api/admin/ {
            return 404;
        }
        proxy_pass $lootchain_game;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # 必须"覆盖"而不是追加:IpUtil 取 X-Forwarded-For 第一个值(支付回调 / 风控按 IP)
        proxy_set_header X-Forwarded-For $lootchain_client_ip;
        proxy_set_header X-Real-IP $lootchain_client_ip;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location ^~ /ws/ {
        proxy_pass $lootchain_game;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $lootchain_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $lootchain_client_ip;
        proxy_set_header X-Real-IP $lootchain_client_ip;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # ---------- 静态资源缓存策略(同 deploy/nginx/lootchain-game.conf) ----------
    location = /index.html   { add_header Cache-Control "no-cache"; }
    location = /sw.js        { add_header Cache-Control "no-cache"; }
    location = /version.json { add_header Cache-Control "no-cache"; }
    location = /asset-manifest.json { add_header Cache-Control "no-cache"; }
    location = /src/effect.bin { add_header Cache-Control "no-cache"; }
    location = /healthz { access_log off; return 200 "ok"; }

    location ~* "(\.[0-9a-f]{5}\.[a-z0-9]+|-[A-Za-z0-9_-]{8}\.(js|wasm|bin))$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
}
