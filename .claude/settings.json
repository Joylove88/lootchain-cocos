{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/memory_sync.sh\" pull",
            "timeout": 30,
            "statusMessage": "同步记忆仓库"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/memory_sync.sh\" push",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
