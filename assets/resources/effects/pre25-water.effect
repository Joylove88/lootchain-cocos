// 预渲染 2.5D · 主城 v4:流动的水(11-19 用户:「河流是流动的吧?不是静态的吧」)。
// 叠在预渲染底图上面、人物下面(Pre25Actors.mountWater):底图里的水是拍死的,这层只加会动的东西 —— 顺流漂走的波纹(亮的波峰 + 略暗的波谷)、
// 月光碎闪、岸边一线水光。网格 uv0 = (沿河往下游的米数, 横向米数),港湾 / 池塘是 (x, z) 米;uv1 = 整图位置(查遮罩:桥 / 码头 / 船 / 河岸 / 树挡住的地方不画);
// 顶点色 r = 流速(河 1,港湾 / 池塘接近 0)。没有贴图,纹样全是程序噪声。
CCEffect %{
  techniques:
  - passes:
    - vert: water-vs:vert
      frag: water-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        maskTex: { value: black }
        tint: { value: [0.62, 0.72, 0.92, 1.0], editor: { type: color } }
        params: { value: [1.0, 5.6, 1.0, 0.0] }
}%

CCProgram water-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec2 a_texCoord1;
  in vec4 a_color;

  out vec2 v_flow;
  out vec2 v_mask;
  out float v_speed;
  out float v_rad;

  vec4 vert () {
    v_flow = a_texCoord;
    v_mask = a_texCoord1;
    v_speed = a_color.r;
    v_rad = a_color.g;
    return cc_matViewProj * cc_matWorld * vec4(a_position, 1.0);
  }
}%

CCProgram water-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec2 v_flow;
  in vec2 v_mask;
  in float v_speed;
  in float v_rad;

  uniform sampler2D maskTex;
  uniform Water {
    vec4 tint;
    vec4 params;      // x = 整体强度,y = 河的半宽(米,岸边水光用),z = 流速倍数
  };

  // 不用 sin 的哈希(Dave Hoskins hash12):sin(大数) × 43758 在坐标几十米以上时精度崩,相邻格子的随机值连成直线 → 碎闪排成一道道「划痕」(11-20)
  float hash (vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }
  float noise (vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), f.x), mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), f.x), f.y);
  }
  float fbm (vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
      v += a * noise(p);
      p = p * 2.03 + vec2(1.7, 9.2);
      a *= 0.5;
    }
    return v;
  }

  // 点状碎闪:每格随机一个点,离点近 = 亮,亮度按格子各自的相位一闪一闪(11-20:噪声阈值的碎闪顺着流向拉成一道道「划痕」)
  float sparkle (vec2 q, float t) {
    vec2 c = floor(q);
    vec2 f = fract(q);
    float h = hash(c);
    vec2 o = vec2(hash(c + 17.3), hash(c + 41.9)) * 0.7 + 0.15;
    float d = length(f - o);
    float tw = max(0.0, sin(t * (1.6 + 2.2 * h) + h * 40.0));
    tw = tw * tw * tw * tw;
    return smoothstep(0.11, 0.0, d) * tw * step(0.55, h);
  }

  // 水面起伏的高度场:两层各向略异的 fbm(顺流方向拉长一点)
  float waves (vec2 q) {
    return fbm(vec2(q.x * 0.55, q.y * 0.85)) * 0.65 + fbm(vec2(q.x * 1.3, q.y * 1.7) + vec2(4.7, 2.3)) * 0.35;
  }

  vec4 frag () {
    float m = texture(maskTex, v_mask).r;
    if (m < 0.01) {
      discard;
    }
    float t = cc_time.x;
    float sp = clamp(v_speed, 0.0, 1.0);
    vec2 p = v_flow;
    // 离岸多近(0 = 河心 / 湖心,1 = 岸边):河按横向米数,港湾 / 池塘按顶点里带的径向值
    float across = sp > 0.5 ? clamp(abs(p.y) / max(params.y, 0.1), 0.0, 1.0) : clamp(v_rad, 0.0, 1.0);
    // ── 流速场(11-20 用户「水流看着太生硬」:原来整张花纹匀速平移)──
    // 局部流向 / 流速被一层慢慢变的大噪声扰动:河心快、岸边慢,有的地方打旋偏一点
    vec2 wq = p * 0.12 + vec2(t * 0.03, -t * 0.02);
    vec2 warp = vec2(fbm(wq), fbm(wq + vec2(5.2, 1.3))) - 0.5;
    float spd = sp * params.z * 0.55 * (1.0 - 0.6 * across * across);
    vec2 vel = vec2(1.0, 0.0) * spd * (0.75 + 0.7 * warp.x) + vec2(0.0, 1.0) * spd * 0.45 * warp.y;
    vel += vec2(warp.y, -warp.x) * 0.06 * (1.0 - sp);          // 港湾 / 池塘:几乎不流,只微微漂
    // ── 双相位:两层波纹各自顺流漂一段再淡出,交替接上(花纹在流里变形、更新,而不是一块板子滑走)──
    float T = 2.6;
    float ph0 = fract(t / T);
    float ph1 = fract(t / T + 0.5);
    float w0 = 1.0 - abs(1.0 - 2.0 * ph0);
    vec2 o0 = vel * ph0 * T * 1.6 + vec2(0.0, 0.0);
    vec2 o1 = vel * ph1 * T * 1.6 + vec2(3.7, 1.9);
    // 静水自己的慢起伏(随时间缓缓变形)
    vec2 drift = vec2(t * 0.05, -t * 0.035);
    vec2 e = vec2(0.12, 0.0);
    vec2 q0 = p - o0 + drift;
    vec2 q1 = p - o1 + drift;
    float h0 = waves(q0);
    float h1 = waves(q1);
    float h = mix(h1, h0, w0);
    // 斜率(有限差分)→ 水面朝向:决定映天的深浅和太阳反光
    float hx = mix(waves(q1 + e.xy), waves(q0 + e.xy), w0) - h;
    float hy = mix(waves(q1 + e.yx), waves(q0 + e.yx), w0) - h;
    vec2 slope = vec2(hx, hy) / e.x;
    // ── 底色(参考燕云十六声):河心青蓝偏深、岸边浅一点带青绿 ──
    vec3 deep = vec3(0.11, 0.25, 0.31);
    vec3 shallow = vec3(0.24, 0.38, 0.36);
    vec3 col = mix(deep, shallow, smoothstep(0.45, 1.0, across));
    // ── 天光倒影:大块慢云影 + 朝向镜头一侧的波面映更多天(柔和,不发白)──
    float cloud = fbm(vec2(p.x * 0.045 - t * 0.012, p.y * 0.07 + t * 0.004) + vec2(7.3, 1.1));
    vec3 sky = vec3(0.62, 0.74, 0.84);
    float facing = clamp(0.5 + 0.9 * dot(slope, vec2(-0.55, 0.65)), 0.0, 1.0);
    col = mix(col, sky, 0.06 + 0.12 * smoothstep(0.4, 0.8, cloud) + 0.16 * facing * facing);
    col *= 0.9 + 0.16 * h;
    // ── 太阳反光:波面正好朝太阳的地方,一点一点亮(不跟着整体平移,只在起伏里闪)──
    float sunAlign = dot(normalize(vec3(-slope.x, 1.0, -slope.y) + vec3(0.0, 0.0, 0.0)), normalize(vec3(0.45, 1.0, -0.35)));
    float spec = pow(clamp(sunAlign, 0.0, 1.0), 360.0);
    vec2 cq = (p - mix(o1, o0, w0) * 0.5) * 2.2;
    float tw = sparkle(cq, t) * smoothstep(0.5, 0.75, h);
    float glint = clamp(spec * 0.8 + tw * 0.7, 0.0, 1.0);
    col += vec3(1.0, 0.97, 0.9) * glint * 0.8;
    // ── 岸边水光:一圈柔的浅色,边上被波纹打碎(不是一条匀的线)──
    float foam = smoothstep(0.86, 1.0, across) * smoothstep(0.35, 0.75, mix(waves(q1 * 2.3), waves(q0 * 2.3), w0) + 0.15 * (1.0 - across));
    col = mix(col, vec3(0.76, 0.83, 0.84), foam * 0.38);
    float a = clamp(0.86 + 0.12 * glint + 0.08 * foam, 0.0, 0.98) * params.x * m * tint.a;
    return vec4(col, a);
  }
}%
